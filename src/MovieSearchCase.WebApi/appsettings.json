{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CorsPolicy": {
    "AllowedOrigins": ["http://localhost:3000"]
  },
  "HybridCache": {
    "DefaultEntryOptions": {
      "Expiration": "00:05:00",
      "LocalCacheExpiration": "00:05:00"
    },
    "DistributedCache": {
      "Redis": {
        "ConnectionString": "",
        "InstanceName": "MovieSearch:"
      }
    }
  },
  "TmdbOptions": {
    "BaseUrl": "https://api.themoviedb.org/3/",
    "AccessToken": ""
  }
}
